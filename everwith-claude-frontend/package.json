{
  "name": "everwith-claude-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Independent Everwith desktop-first frontend rebuild (local mock adapter; no live services).",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "assets:sync": "node scripts/sync-assets.mjs",
    "assets:check": "node scripts/sync-assets.mjs --check",
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "check": "tsc -p tsconfig.json --noEmit && vitest run",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "rules:check": "vitest run tests/engines.test.ts",
    "test:e2e:quick": "playwright test --grep-invert @long",
    "assets:refs": "node scripts/check-asset-refs.mjs",
    "assets:generated": "node scripts/check-generated.mjs"
  },
  "dependencies": {
    "lucide-react": "0.545.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "jsdom": "27.0.1",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "4.0.6"
  }
}
